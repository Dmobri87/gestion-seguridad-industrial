# =============================================================================
# Docker Ignore - Backend
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
dist/
build/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Environment and secrets
.env
.env.*
*.env

# Database files (local development)
*.db
*.sqlite
*.sqlite3

# Logs (generated at runtime)
logs/
*.log

# Uploads (mounted as volume)
uploads/

# Tests
tests/
pytest.ini
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/

# Documentation
docs/
*.md
!README.md

# OS files
.DS_Store
Thumbs.db
