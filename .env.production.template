# =============================================================================
# VARIABLES DE ENTORNO - PRODUCCION (TEMPLATE)
# Sistema de Gestion de Seguridad Industrial y Salud Ocupacional
# =============================================================================
#
# Instrucciones:
#   1. Copie este archivo como .env en el servidor de produccion:
#        cp .env.production.template .env
#   2. Reemplace TODOS los valores marcados con "CHANGE_ME" o "your-*"
#   3. Restrinja permisos: chmod 600 .env
#   4. NUNCA suba el archivo .env al repositorio
#
# =============================================================================


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://seguridad_user:CHANGE_ME_DB_PASSWORD@db:5432/seguridad_industrial
POSTGRES_USER=seguridad_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=seguridad_industrial
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a secure key with: openssl rand -base64 64
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=False


# -----------------------------------------------------------------------------
# CORS - Allowed Origins
# -----------------------------------------------------------------------------
# Use the actual production domain. Separate multiple origins with commas.
CORS_ORIGINS=https://yourdomain.com


# -----------------------------------------------------------------------------
# SMTP for 2FA (OTP emails)
# -----------------------------------------------------------------------------
# Required in production. Without SMTP, OTP codes are returned in the API
# response, which is a critical security risk.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com


# -----------------------------------------------------------------------------
# Domain
# -----------------------------------------------------------------------------
DOMAIN=yourdomain.com


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Sistema de Gestion Enterprise
APP_VERSION=2.0.0


# -----------------------------------------------------------------------------
# Redis (Cache & Rate Limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# File Storage - MinIO (future)
# -----------------------------------------------------------------------------
# Uncomment when MinIO object storage is integrated:
# MINIO_ROOT_USER=CHANGE_ME_minio_user
# MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
# MINIO_ENDPOINT=minio:9000
