# ================================================================
# VARIABLES DE ENTORNO - SISTEMA DE GESTION DE SEGURIDAD INDUSTRIAL
# ================================================================
# Este archivo es una plantilla con TODAS las variables de entorno
# necesarias para ejecutar el proyecto. Copie este archivo como .env
# y complete los valores segun su entorno.
#
#   cp .env.example .env
#
# IMPORTANTE: Nunca suba el archivo .env al repositorio.
# ================================================================


# ────────────────────────────────────────────────────────────────
# BASE DE DATOS POSTGRESQL
# ────────────────────────────────────────────────────────────────
# Credenciales individuales de PostgreSQL (usadas por docker-compose
# para crear la base de datos automaticamente)
POSTGRES_USER=gestion_user
POSTGRES_PASSWORD=cambiar_por_password_seguro
POSTGRES_DB=gestion_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL de conexion completa a la base de datos.
# - Para desarrollo local con SQLite (sin Docker):
#     DATABASE_URL=sqlite:///./seguridad_industrial.db
# - Para PostgreSQL con Docker:
#     DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=sqlite:///./seguridad_industrial.db


# ────────────────────────────────────────────────────────────────
# SEGURIDAD Y AUTENTICACION (JWT)
# ────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT. DEBE tener al menos 32 caracteres.
# Genere una clave segura ejecutando:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIAR_ESTO_generar_con_python_secrets_token_urlsafe_64

# Algoritmo de firma para los tokens JWT (no cambiar salvo necesidad especifica)
ALGORITHM=HS256

# Tiempo de expiracion del token de acceso en minutos.
# 30 minutos es adecuado para la mayoria de los casos.
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ────────────────────────────────────────────────────────────────
# CONFIGURACION DE LA APLICACION
# ────────────────────────────────────────────────────────────────
# Nombre de la aplicacion (informativo, aparece en metadata)
APP_NAME=Sistema de Gestion Enterprise

# Version de la aplicacion
APP_VERSION=2.0.0

# Modo debug: activa documentacion interactiva (/docs, /redoc).
# En produccion SIEMPRE debe ser False.
# Valores validos: True, False, 1, 0, yes, no
DEBUG=True


# ────────────────────────────────────────────────────────────────
# CORS - ORIGENES PERMITIDOS
# ────────────────────────────────────────────────────────────────
# Lista de origenes (URLs del frontend) separados por comas.
# En desarrollo local suele ser http://localhost:3000
# En produccion, usar el dominio real del frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# ────────────────────────────────────────────────────────────────
# HOSTS CONFIABLES (Trusted Host Middleware)
# ────────────────────────────────────────────────────────────────
# Lista de hostnames permitidos, separados por comas.
# Usar "*" para permitir cualquier host (solo desarrollo).
# En produccion, restringir a los dominios reales.
ALLOWED_HOSTS=*


# ────────────────────────────────────────────────────────────────
# RATE LIMITING Y OTP
# ────────────────────────────────────────────────────────────────
# Intentos maximos de login por IP+email cada 5 minutos
MAX_LOGIN_ATTEMPTS=5

# Duracion del codigo OTP en minutos
OTP_EXPIRE_MINUTES=5


# ────────────────────────────────────────────────────────────────
# EMAIL SMTP (Autenticacion 2FA mediante OTP)
# ────────────────────────────────────────────────────────────────
# Configuracion del servidor SMTP para enviar codigos OTP por email.
# Si no se configuran, el codigo OTP se devuelve en la respuesta
# de la API (solo util para desarrollo, NUNCA en produccion).

# Host del servidor SMTP (ej: smtp.gmail.com, smtp.office365.com)
SMTP_HOST=

# Puerto del servidor SMTP (587 para STARTTLS, 465 para SSL)
SMTP_PORT=587

# Usuario de autenticacion SMTP (generalmente el email completo)
SMTP_USER=

# Contrasena o "App Password" del servidor SMTP
SMTP_PASSWORD=

# Direccion de email que aparece como remitente
SMTP_FROM=noreply@seguridad-industrial.com


# ────────────────────────────────────────────────────────────────
# REDIS - Cache y Rate Limiting
# ────────────────────────────────────────────────────────────────
# URL de conexion a Redis. Dejar vacio para usar almacenamiento en memoria
# (no recomendado para produccion ya que los tokens revocados se pierden al reiniciar)
# Formato: redis://[:password@]host:port/db
REDIS_URL=
REDIS_PASSWORD=

# ────────────────────────────────────────────────────────────────
# DOMINIO DE LA APLICACION
# ────────────────────────────────────────────────────────────────
# Dominio donde se desplegara la aplicacion (sin https://)
# Se usa para configurar CORS, cookies y certificados SSL
DOMAIN=localhost

# ────────────────────────────────────────────────────────────────
# ALMACENAMIENTO DE ARCHIVOS - MinIO (futuro)
# ────────────────────────────────────────────────────────────────
# Estas variables estan reservadas para cuando se integre MinIO
# como almacenamiento de objetos (evidencias, documentos, etc.)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_ENDPOINT=minio:9000
